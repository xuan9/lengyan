{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuxuan:classic-apps:contracts:behavior-fixture:v1",
  "title": "Classic Apps Cross-platform Behavior Fixture",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/audioStartDecision"
    },
    {
      "$ref": "#/$defs/shareFileName"
    },
    {
      "$ref": "#/$defs/deepLink"
    },
    {
      "$ref": "#/$defs/searchText"
    },
    {
      "$ref": "#/$defs/dailyVerseSelection"
    },
    {
      "$ref": "#/$defs/readingResume"
    },
    {
      "$ref": "#/$defs/legacyFavoritesMigration"
    },
    {
      "$ref": "#/$defs/legacyLocationResolution"
    }
  ],
  "$defs": {
    "fixtureHeader": {
      "type": "object",
      "required": [
        "schemaVersion",
        "fixtureID",
        "behavior",
        "cases"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/schemaVersion"
        },
        "fixtureID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "behavior": {
          "type": "string"
        },
        "cases": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "audioStartDecision": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/fixtureHeader"
        },
        {
          "type": "object",
          "properties": {
            "behavior": {
              "const": "audio-start-decision"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/audioStartCase"
              }
            }
          }
        }
      ]
    },
    "audioStartCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "savedArtifactID",
            "requestedArtifactID",
            "savedTimeSeconds"
          ],
          "properties": {
            "savedArtifactID": {
              "type": [
                "string",
                "null"
              ]
            },
            "requestedArtifactID": {
              "type": "string",
              "minLength": 1
            },
            "savedTimeSeconds": {
              "type": "number"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startMode"
          ],
          "properties": {
            "startMode": {
              "enum": [
                "beginning",
                "resume"
              ]
            },
            "seekTimeSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "shareFileName": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/fixtureHeader"
        },
        {
          "type": "object",
          "properties": {
            "behavior": {
              "const": "share-file-name"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/shareFileNameCase"
              }
            }
          }
        }
      ]
    },
    "shareFileNameCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locale",
            "defaultBaseName",
            "source",
            "kind",
            "uniqueSuffix"
          ],
          "properties": {
            "locale": {
              "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/locale"
            },
            "defaultBaseName": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "enum": [
                "image",
                "text"
              ]
            },
            "uniqueSuffix": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "pageNumber": {
              "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/positiveSafeInteger"
            },
            "pageCount": {
              "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/positiveSafeInteger"
            }
          },
          "dependentRequired": {
            "pageNumber": [
              "pageCount"
            ],
            "pageCount": [
              "pageNumber"
            ]
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileName"
          ],
          "properties": {
            "fileName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "deepLink": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/fixtureHeader"
        },
        {
          "type": "object",
          "properties": {
            "behavior": {
              "const": "deep-link"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/deepLinkCase"
              }
            }
          }
        }
      ]
    },
    "deepLinkCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted"
          ],
          "properties": {
            "accepted": {
              "type": "boolean"
            },
            "productID": {
              "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/productID"
            },
            "legacyPath": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "searchText": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/fixtureHeader"
        },
        {
          "type": "object",
          "properties": {
            "behavior": {
              "const": "search-text"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/searchTextCase"
              }
            }
          }
        }
      ]
    },
    "searchTextCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "query",
            "path",
            "maxLength"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "query": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "maxLength": {
              "type": "integer",
              "minimum": 4,
              "maximum": 200
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normalizedText",
            "normalizedQuery",
            "matches",
            "resultPath",
            "snippet"
          ],
          "properties": {
            "normalizedText": {
              "type": "string"
            },
            "normalizedQuery": {
              "type": "string"
            },
            "matches": {
              "type": "boolean"
            },
            "resultPath": {
              "type": [
                "string",
                "null"
              ]
            },
            "snippet": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "dailyVerseSelection": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/fixtureHeader"
        },
        {
          "type": "object",
          "properties": {
            "behavior": {
              "const": "daily-verse-selection"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dailyVerseSelectionCase"
              }
            }
          }
        }
      ]
    },
    "dailyVerseSelectionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "productID",
            "contentVersion",
            "instant",
            "timeZone",
            "candidateIDs",
            "excludedID"
          ],
          "properties": {
            "productID": {
              "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/productID"
            },
            "contentVersion": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "instant": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
            },
            "timeZone": {
              "type": "string",
              "minLength": 1
            },
            "candidateIDs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "excludedID": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "localDate",
            "selectedID"
          ],
          "properties": {
            "localDate": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "selectedID": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "readingResume": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/fixtureHeader"
        },
        {
          "type": "object",
          "properties": {
            "behavior": {
              "const": "reading-resume"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/readingResumeCase"
              }
            }
          }
        }
      ]
    },
    "readingResumeCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "path",
            "pageIndex",
            "chapter",
            "chapterOffset"
          ],
          "properties": {
            "mode": {
              "enum": [
                "chapter",
                "paged",
                "tree"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "pageIndex": {
              "type": [
                "integer",
                "null"
              ]
            },
            "chapter": {
              "type": [
                "integer",
                "null"
              ]
            },
            "chapterOffset": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target"
          ],
          "properties": {
            "target": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/readingResumeTarget"
                }
              ]
            }
          }
        }
      }
    },
    "readingResumeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "chapter",
            "paged",
            "tree"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pageIndex": {
          "type": "integer",
          "minimum": 0
        },
        "chapter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "chapterOffset": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "legacyFavoritesMigration": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/fixtureHeader"
        },
        {
          "type": "object",
          "properties": {
            "behavior": {
              "const": "legacy-favorites-migration"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/legacyFavoritesMigrationCase"
              }
            }
          }
        }
      ]
    },
    "legacyFavoritesMigrationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legacyLikes",
            "storedUserLikes",
            "curatedLegacyPaths"
          ],
          "properties": {
            "legacyLikes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "storedUserLikes": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "curatedLegacyPaths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userLikes"
          ],
          "properties": {
            "userLikes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "legacyLocationResolution": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        {
          "$ref": "#/$defs/fixtureHeader"
        },
        {
          "type": "object",
          "properties": {
            "behavior": {
              "const": "legacy-location-resolution"
            },
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/legacyLocationResolutionCase"
              }
            }
          }
        }
      ]
    },
    "legacyLocationResolutionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "productID",
            "legacyPath",
            "usage"
          ],
          "properties": {
            "productID": {
              "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/productID"
            },
            "legacyPath": {
              "type": "string"
            },
            "usage": {
              "enum": [
                "favorite",
                "resume"
              ]
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sectionID",
            "paragraphID"
          ],
          "properties": {
            "status": {
              "enum": [
                "mapped",
                "invalid",
                "unresolved"
              ]
            },
            "sectionID": {
              "type": [
                "string",
                "null"
              ]
            },
            "paragraphID": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
