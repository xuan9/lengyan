{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuxuan:classic-apps:contracts:content-package:v1",
  "title": "Classic Apps Canonical Content Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productID",
    "bookID",
    "editionID",
    "contentVersion",
    "contentStatus",
    "locale",
    "normalization",
    "contentHash",
    "volumes",
    "sections",
    "paragraphs"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/schemaVersion"
    },
    "productID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/productID"
    },
    "bookID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/bookID"
    },
    "editionID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/editionID"
    },
    "contentVersion": {
      "type": "string",
      "minLength": 1
    },
    "contentStatus": {
      "enum": [
        "legacy-migration",
        "release-canonical"
      ]
    },
    "locale": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/locale"
    },
    "normalization": {
      "const": "utf8-nfc-lf-v1"
    },
    "contentHash": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/sha256"
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/volume"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/paragraph"
      }
    }
  },
  "$defs": {
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "volumeID",
        "number",
        "order",
        "title",
        "sourceReferences"
      ],
      "properties": {
        "volumeID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]{6}$"
        },
        "number": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/positiveSafeInteger"
        },
        "order": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/nonnegativeSafeInteger"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceReferences": {
          "$ref": "#/$defs/sourceReferences"
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionID",
        "parentSectionID",
        "order",
        "title",
        "sourceReferences"
      ],
      "properties": {
        "sectionID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.s[0-9]{6}$"
        },
        "parentSectionID": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]*\\.s[0-9]{6}$"
        },
        "order": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/nonnegativeSafeInteger"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "sourceReferences": {
          "$ref": "#/$defs/sourceReferences"
        },
        "legacyIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paragraphID",
        "sectionID",
        "volumeID",
        "order",
        "textRole",
        "text",
        "sourceReferences"
      ],
      "properties": {
        "paragraphID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.p[0-9]{6}$"
        },
        "sectionID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.s[0-9]{6}$"
        },
        "volumeID": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]*\\.v[0-9]{6}$"
        },
        "order": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/nonnegativeSafeInteger"
        },
        "textRole": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceReferences": {
          "$ref": "#/$defs/sourceReferences"
        },
        "legacyIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "legacyVolumeHint": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/positiveSafeInteger"
        }
      }
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceID",
          "locator"
        ],
        "properties": {
          "sourceID": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
