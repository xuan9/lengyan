{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuxuan:classic-apps:contracts:legacy-map:v1",
  "title": "Classic Apps Legacy Identity Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productID",
    "bookID",
    "editionID",
    "mappingVersion",
    "stableIDScheme",
    "normalization",
    "mappingHash",
    "paths"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/schemaVersion"
    },
    "productID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/productID"
    },
    "bookID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/bookID"
    },
    "editionID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/editionID"
    },
    "mappingVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stableIDScheme": {
      "const": "fuxuan-classics-v1"
    },
    "normalization": {
      "const": "utf8-nfc-lf-v1"
    },
    "mappingHash": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/sha256"
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pathMapping"
      }
    }
  },
  "$defs": {
    "pathMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyPath",
        "legacyNodeID",
        "parentLegacyPath",
        "sectionID",
        "order",
        "directParagraphIDs",
        "firstDescendantParagraphID",
        "descendantParagraphCount"
      ],
      "properties": {
        "legacyPath": {
          "type": "string",
          "pattern": "^(?:|/(?:[A-Z][0-9]+)(?:/[A-Z][0-9]+)*)$"
        },
        "legacyNodeID": {
          "type": "string",
          "pattern": "^(?:ROOT|[A-Z][0-9]+)$"
        },
        "parentLegacyPath": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:|/(?:[A-Z][0-9]+)(?:/[A-Z][0-9]+)*)$"
        },
        "sectionID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.s[0-9]{6}$"
        },
        "order": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/nonnegativeSafeInteger"
        },
        "directParagraphIDs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.p[0-9]{6}$"
          }
        },
        "firstDescendantParagraphID": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9-]*\\.p[0-9]{6}$"
        },
        "descendantParagraphCount": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/nonnegativeSafeInteger"
        }
      }
    }
  }
}
