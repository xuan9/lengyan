{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fuxuan:classic-apps:contracts:source-manifest:v1",
  "title": "Classic Apps Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productID",
    "bookID",
    "editionID",
    "reviewStatus",
    "releaseEligibility",
    "approvals",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/schemaVersion"
    },
    "productID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/productID"
    },
    "bookID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/bookID"
    },
    "editionID": {
      "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/editionID"
    },
    "reviewStatus": {
      "enum": [
        "legacy-unverified",
        "candidate",
        "approved",
        "rejected"
      ]
    },
    "releaseEligibility": {
      "enum": [
        "blocked",
        "eligible"
      ]
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textAccuracy",
        "rights"
      ],
      "properties": {
        "textAccuracy": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/approval"
        },
        "rights": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/approval"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceID",
        "role",
        "format",
        "title",
        "sourceURI",
        "retrievedOn",
        "rights",
        "artifacts"
      ],
      "properties": {
        "sourceID": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "role": {
          "enum": [
            "legacy-runtime-input",
            "canonical-input",
            "collation-reference",
            "transcription-base",
            "translation-reference"
          ]
        },
        "format": {
          "enum": [
            "repository-json",
            "tei-xml",
            "scan-images",
            "plain-text"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "canonicalIdentifier": {
          "type": "string",
          "minLength": 1
        },
        "sourceHeaderAttribution": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/localizedStrings"
        },
        "sourceURI": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "retrievedOn": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/date"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commercialUse",
        "redistribution",
        "statement"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "restricted-noncommercial",
            "public-domain",
            "product-license"
          ]
        },
        "commercialUse": {
          "enum": [
            "unknown",
            "requires-permission",
            "permitted"
          ]
        },
        "redistribution": {
          "enum": [
            "unknown",
            "header-required",
            "permitted"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "statementURI": {
          "type": "string",
          "minLength": 1
        },
        "licenseIdentifier": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "product-license"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "statementURI": {
                "type": "string",
                "minLength": 1
              },
              "licenseIdentifier": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "statementURI",
              "licenseIdentifier"
            ]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "bytes",
        "sha256"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "pathWithinSource": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/relativePath"
        },
        "bytes": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/positiveSafeInteger"
        },
        "sha256": {
          "$ref": "urn:fuxuan:classic-apps:contracts:common:v1#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "releaseEligibility": {
            "const": "eligible"
          }
        },
        "required": [
          "releaseEligibility"
        ]
      },
      "then": {
        "properties": {
          "reviewStatus": {
            "const": "approved"
          },
          "approvals": {
            "type": "object",
            "properties": {
              "textAccuracy": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                }
              },
              "rights": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
