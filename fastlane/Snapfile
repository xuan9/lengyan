# Snapfile — fastlane snapshot 配置
# 文档: https://docs.fastlane.tools/actions/snapshot/

# ────────────────────────────────────────────────────────
# 设备列表
#   iPhone 13 Pro Max     → 1284 × 2778 (App Store 接受的 iPhone 截图规格)
#   iPad Pro 13-inch (M5) → 13" (iPad 必需规格)
# ────────────────────────────────────────────────────────
devices([
  "iPhone 13 Pro Max",
  "iPad Pro 13-inch (M5)"
])

# ────────────────────────────────────────────────────────
# 本地化（简体 + 繁体）
# ────────────────────────────────────────────────────────
languages([
  "zh-Hans",
  "zh-Hant"
])

# Scheme（必须包含 UITest target）
scheme("lengyan")

# 输出目录（与现有 screenshots/ 分离，避免污染）
output_directory("./fastlane/screenshots")

# 每次跑前清空输出
clear_previous_screenshots(true)

# iOS Simulator 版本
# fastlane 2.226 会从 SDK 26.2 推导设备版本，遇到本机 26.3.1 runtime 时
# 回退成 OS=26.3，导致 xcodebuild 精确匹配失败。
# Fastfile 的 screenshots lane 会改用 UDID destination；这里保留完整版本用于配置可读性。
ios_version("26.3.1")

# 只跑指定的截图测试（避免运行所有 UITest）
only_testing("lengyanUITests/SutraSnapshotTests/testAppStoreScreenshots")

# 重试次数（模拟器偶发启动失败时）
number_of_retries(2)

# 串行跑设备（避免 x86_64 Mac 多 destination 并行失败）
concurrent_simulators(false)

# 首次失败就停（更快诊断）
stop_after_first_error(true)
